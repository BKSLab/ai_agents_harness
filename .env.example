# Names only. Set values outside the repository; this file is not loaded automatically.
BITRIX_PORTAL_URL=
BITRIX_WEBHOOK_USER_ID=
BITRIX_WEBHOOK_TOKEN=
# Optional absolute paths and bounded request limits.
BITRIX_PROFILE=
BITRIX_CA_BUNDLE=
BITRIX_TIMEOUT_SECONDS=20
BITRIX_READ_RETRIES=2
# Optional GitLab integration. Keep the host and credential outside the repository.
GITLAB_HOST=
GITLAB_TOKEN=
GITLAB_PROFILE=
GITLAB_CA_BUNDLE=
GITLAB_TIMEOUT_SECONDS=20
GITLAB_READ_RETRIES=2
# Enable only for an explicitly chosen HTTP instance; its token travels without TLS.
GITLAB_ALLOW_INSECURE_HTTP=0
HARNESS_HOME=
